{
  "name": "@egoist/tipc",
  "version": "0.3.2",
  "description": "Typesafe IPC for Electron",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
